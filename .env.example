# Comma-separated origins of the host pages allowed to submit feedback (exact match, no trailing slash).
# Defaults to http://localhost:4000 when unset.
FEEDBACK_ALLOWED_ORIGINS=http://localhost:4000

# Bearer token required by the admin API (list / detail / update).
# Defaults to "dev-admin-token" outside production; in production the admin API is
# locked (always 401) until this is set. Use a long random value and never commit it.
FEEDBACK_ADMIN_TOKEN=
