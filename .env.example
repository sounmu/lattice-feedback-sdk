# Comma-separated origins of the host pages allowed to submit feedback (exact match, no trailing slash).
# Defaults to http://localhost:4000 when unset.
FEEDBACK_ALLOWED_ORIGINS=http://localhost:4000

# Comma-separated public origins this app (and its /widget iframe) is served from, as seen by browsers.
# Used to verify feedback submissions from browsers that do not send Sec-Fetch-Site.
# Defaults to http://localhost:3000 outside production; set it in production.
FEEDBACK_APP_ORIGINS=http://localhost:3000

# Request header that YOUR reverse proxy sets (and overwrites) with the client IP, used for rate limiting.
# Leave empty on Vercel (x-vercel-forwarded-for is used automatically). Without it, all clients share one limit.
FEEDBACK_CLIENT_IP_HEADER=

# Bearer token required by the admin API (list / detail / update).
# Defaults to "dev-admin-token" outside production; in production the admin API is
# locked (always 401) until this is set. Use a long random value and never commit it.
FEEDBACK_ADMIN_TOKEN=
