{
  "name": "lattice-feedback-sdk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:sdk": "esbuild src/sdk/index.ts --bundle --minify --format=iife --target=es2019 --outfile=public/sdk.js",
    "dev": "npm run build:sdk && next dev",
    "build": "npm run build:sdk && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rrweb/record": "2.2.2",
    "@rrweb/replay": "2.2.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rrweb-snapshot": "2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
